# um regex (grep -E) por linha. Linhas começando com # são comentários.
\b192\.168\.[0-9]+\.[0-9]+\b
\b10\.[0-9]+\.[0-9]+\.[0-9]+\b
\b0000[0-9]{4}-[0-9A-F]{16}\b
\b[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}\b
[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.(com|br|net|org)\b
(^|[^0-9.])\(?[0-9]{2}\)? ?9[0-9]{4}-?[0-9]{4}([^0-9]|$)
\b(sk|pk)-[A-Za-z0-9]{20,}\b
\bhf_[A-Za-z0-9]{20,}\b
\bghp_[A-Za-z0-9]{30,}\b
BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY
/Users/[a-z]+
